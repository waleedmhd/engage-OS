# EngageOS — root environment template
# Copy to .env for docker-compose. Keys mirror app/core/config.py:Settings
# exactly (case-sensitive). Empty values fall back to the documented defaults;
# in staging/production several keys are validated as required (see notes).

# ---- General ----
ENV=development                    # development | staging | production | test
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=console                 # console | json
FRONTEND_URL=http://localhost:3000

# ---- Database ----
# Async DSN; sync (Alembic/Celery) and async forms are derived automatically.
# On Railway set: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql+asyncpg://engageos:engageos@postgres:5432/engageos
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---- Redis / Celery ----
# On Railway set: REDIS_URL=${{Redis.REDIS_URL}}
REDIS_URL=redis://redis:6379/0
# Leave broker/backend empty to default to REDIS_URL.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false     # true only in the test env

# ---- JWT ----
# Required in staging/production: must differ from this default AND be >=32 chars.
JWT_SECRET=change-me-in-production-min-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
# Plain string: single origin or comma-separated list (NOT a JSON array).
CORS_ORIGINS=http://localhost:3000

# ---- Meta WhatsApp Cloud API ----
# META_APP_SECRET and META_VERIFY_TOKEN are required (non-empty) in
# staging/production — the app refuses to start otherwise (Msg-C3 / Msg-M11).
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_API_VERSION=v19.0
META_SEND_RATE_LIMIT=60            # outbound messages/second guard

# ---- Anthropic / Claude AI ----
# Required in staging/production — validated at startup.
ANTHROPIC_API_KEY=
AI_MODEL_BULK=claude-haiku-4-5-20251001
AI_MODEL_ESCALATION=claude-sonnet-4-6
AI_MAX_OUTPUT_TOKENS=512
AI_REQUEST_TIMEOUT_SECONDS=15
AI_AUTO_SEND_CONFIDENCE=0.85
AI_ESCALATION_CONFIDENCE_FLOOR=0.50
AI_HISTORY_MESSAGE_LIMIT=20

# ---- Locking ----
CONVERSATION_LOCK_TTL_SECONDS=120

# ---- Frontend ----
# On Railway point these at the api service's public domain.
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ---- Postgres (docker-compose only; ignored on Railway managed plugin) ----
POSTGRES_USER=engageos
POSTGRES_PASSWORD=engageos
POSTGRES_DB=engageos
