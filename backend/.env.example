# Backend environment template — copy to backend/.env

ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console

# Database (async DSN). Sync DSN is derived automatically.
DATABASE_URL=postgresql+asyncpg://engageos:engageos@localhost:5432/engageos

# Redis (also default Celery broker / backend if the next two are blank).
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Auth
JWT_SECRET=change-me-in-production-min-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Meta WhatsApp Cloud API
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=dev-verify-token
META_API_VERSION=v25.0

# Anthropic / Claude AI
ANTHROPIC_API_KEY=
AI_MODEL_BULK=claude-haiku-4-5-20251001
AI_MODEL_ESCALATION=claude-sonnet-4-6
AI_REQUEST_TIMEOUT_SECONDS=15

# CORS / frontend wiring
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
